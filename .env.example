# Local dev uses the dev Supabase project by default.
# Put real values in .env.development.local / .env.production.local (gitignored).
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-dev-publishable-key
# Asset base path; defaults to /test/. Set to / for a root deployment.
# VITE_BASE_PATH=/test/
